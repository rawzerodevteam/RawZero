{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "rawstudio",
  "version": "0.1.0",
  "identifier": "com.rawstudio.app",
  "build": {
    "frontendDist": "../frontend/dist",
    "beforeBuildCommand": "npm run build --prefix ../frontend"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "resources": {
      "../backend/dist/rawstudio-backend": "backend",
      "../frontend/dist": "frontend-dist"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  }
}
