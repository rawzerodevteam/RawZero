{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "rawstudio",
  "version": "0.1.0",
  "identifier": "com.rawstudio.app",
  "build": {
    "frontendDist": "../frontend/dist",
    "beforeBuildCommand": "npm run build --prefix ../frontend"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "deb", "rpm"],
    "createUpdaterArtifacts": true,
    "resources": {
      "../backend/dist/rawstudio-backend": "backend",
      "../frontend/dist": "frontend-dist"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "both",
        "languages": ["French", "English"],
        "displayLanguageSelector": true,
        "installerHooks": "installer-hooks.nsh"
      }
    },
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/rawzerodevteam/RawZero/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDM1RTcxQTYzQUNCRTEwNDAKUldSQUVMNnNZeHJuTmE0MjQ5U2VMNlJCK1MybHZuNVdBQWxNNk9zNnpjQlUxM3A5eDJDaWFaQWsK"
    }
  }
}
